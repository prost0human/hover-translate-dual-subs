{
  "manifest_version": 3,
  "name": "__MSG_forkName__",
  "short_name": "Dual Subs",
  "version": "1.4.1",
  "default_locale": "en",
  "description": "__MSG_description__",
  "browser_specific_settings": {
    "gecko": {
      "id": "hover-translate-dual-subs@prost0human.github.io",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["storage"],
  "optional_permissions": [
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://www.bing.com/*"
  ],
  "content_scripts": [
    {
      "all_frames": true,
      "matches": ["*://*.youtube.com/*"],
      "js": ["extension/dist/content.bundle.js"],
      "css": ["extension/dist/styles.css"]
    }
  ],
  "background": {
    "scripts": ["extension/dist/background.bundle.js"]
  },
  "action": {
    "default_popup": "popup/dist/index.html",
    "default_area": "navbar"
  },
  "icons": {
    "16": "assets/icons/logo-16.png",
    "32": "assets/icons/logo-32.png",
    "48": "assets/icons/logo-48.png",
    "128": "assets/icons/logo-128.png"
  }
}
